# Copy this file to .env and fill it in. .env is never committed to Git.
# 複製成 .env 再填入。.env 不會被提交到 Git。
# (Used by the Discord Bot, which is still in development.)
# （Discord Bot 完成後會使用這些設定）

# Bot token from the Discord Developer Portal. If it leaks, reset it immediately.
# Discord 開發者後台取得的 Bot Token，外洩要立刻重新產生
DISCORD_TOKEN=

# Your Discord server (guild) ID. Turn on Developer Mode, then right-click the server icon > Copy Server ID.
# 你們的 Discord 伺服器 ID（開啟開發者模式後，在伺服器圖示按右鍵 > 複製伺服器 ID）
GUILD_ID=

# Discord role names allowed to use president / admin commands (must match the roles in your server exactly)
# 能使用社長 / 管理員指令的 Discord 身分組名稱（必須和伺服器裡的身分組名稱完全一致）
PRESIDENT_ROLE=President
ADMIN_ROLE=Admin

# Message language: both (English + 繁體中文), en, or zh
# 訊息語言：both（中英對照）、en、zh
MESSAGE_LANG=both

# Path of the SQLite database file
# 資料庫檔案位置
DB_PATH=shuttleduel.db

# Default number of courts (the president can change it in the system)
# 預設場地數（社長可在系統中動態調整）
DEFAULT_COURT_COUNT=5
